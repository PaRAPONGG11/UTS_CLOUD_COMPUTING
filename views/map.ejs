<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Peta Sebaran Laporan</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: sans-serif; }
        .nav-top { padding: 15px 20px; background: #fff; display: flex; justify-content: space-between; box-shadow: 0 2px 5px rgba(0,0,0,0.1); z-index: 1000; position: relative; }
        .nav-top a { text-decoration: none; color: #198754; font-weight: bold; font-size: 1.1rem; }
        .live-badge { background: #198754; color: white; padding: 5px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: bold; }
        #map { width: 100%; height: calc(100vh - 55px); }
    </style>
</head>
<body>
    <div class="nav-top">
        <a href="/"><i class="bi bi-chevron-left"></i> Kembali</a>
        <span class="live-badge"><i class="bi bi-broadcast"></i> Live Data</span>
    </div>
    <div id="map"></div>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('map').setView([-6.914744, 107.609810], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '© OpenStreetMap' }).addTo(map);
        
        var laporanData = <%- laporan_list %>;
        laporanData.forEach(function(lap) {
            if(lap.latitude && lap.longitude) {
                var marker = L.marker([lap.latitude, lap.longitude]).addTo(map);
                marker.bindPopup(`
                    <b>${lap.subjek}</b><br>Status: ${lap.status}<br>
                    <a href="/detail/${lap.id}" style="color: #198754; font-weight:bold;">Lihat Detail</a>
                `);
            }
        });
    </script>
</body>
</html>